# Copy to .env (docker compose reads it) or export in your shell. No authentication: localhost only.

# Host-based development (compose sets its own values):
ML_API_URL=http://127.0.0.1:8000
TRIAGEKIT_DB=../data/app.db
TRIAGEKIT_DATA_DIR=../data

# Optional LLM tier / label suggestions (ML service only). Text leaves the machine only when enabled.
TRIAGEKIT_LLM_ENABLED=0
TRIAGEKIT_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
